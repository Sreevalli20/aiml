# Database (Render PostgreSQL will provide this)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/xyz_ai

# JWT Security (REQUIRED - generate a strong random secret)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (choose one - REQUIRED for chat functionality)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS (comma-separated list of allowed origins)
# For local development: http://localhost:3000,http://localhost:5173
# For Vercel production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_NAME=XYZ AI School Assistant
APP_VERSION=1.0.0
DEBUG=false
